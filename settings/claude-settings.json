{
    "$schema": "https://json.schemastore.org/claude-code-settings",
    "permissions": {
        "allow": [
            "Bash(git status)",
            "Bash(git log:*)",
            "Bash(git diff:*)",
            "Bash(git branch)",
            "Bash(git branch -a)",
            "Bash(git branch -r)",
            "Bash(git branch -v)",
            "Bash(git branch -vv)",
            "Bash(git branch --show-current:*)",
            "Bash(git branch --list:*)",
            "Bash(git branch --contains:*)",
            "Bash(git branch --no-contains:*)",
            "Bash(git branch --merged:*)",
            "Bash(git branch --no-merged:*)",
            "Bash(git show:*)",
            "Bash(git remote)",
            "Bash(git remote -v)",
            "Bash(git remote get-url:*)",
            "Bash(git remote show:*)",
            "Bash(git blame:*)",
            "Bash(ls:*)",
            "Bash(pwd)",
            "Bash(cat:*)",
            "Bash(head:*)",
            "Bash(find:*)",
            "Bash(tail:*)",
            "Bash(wc:*)",
            "Bash(echo:*)",
            "Bash(which:*)",
            "Bash(grep:*)",
            "Bash(rg:*)",
            "Bash(fd:*)",
            "Bash(gh pr view:*)",
            "Bash(gh issue view:*)",
            "Bash(gh pr list:*)",
            "Bash(gh issue list:*)",
            "Bash(pytest:*)",
            "Bash(.venv/bin/pytest:*)",
            "Bash(.venv/bin/python -m pytest:*)",
            "Bash(npm test:*)",
            "Bash(npm run lint:*)",
            "Bash(ruff check:*)",
            "Bash(.venv/bin/ruff check:*)",
            "Bash(mypy:*)",
            "Bash(.venv/bin/mypy:*)",
            "Bash(node --version)",
            "Bash(python --version)",
            "Bash(python3 --version)",
            "Bash(uv --version)",
            "Bash(jq:*)",
            "Bash(rtk gain:*)",
            "Bash(rtk discover:*)"
        ],
        "ask": [
            "Bash(git commit:*)",
            "Bash(git push:*)",
            "Bash(git checkout:*)",
            "Bash(git merge:*)",
            "Bash(git rebase:*)",
            "Bash(npm install:*)",
            "Bash(pip install:*)",
            "Bash(uv pip install:*)",
            "Bash(*-exec*)",
            "Bash(*-delete*)",
            "Bash(*rg *--pre*)",
            "Bash(fd *-x*)",
            "Bash(fd *-X*)",
            "Bash(git *--output*)",
            "Bash(echo *>*)"
        ],
        "deny": [
            "Bash(git push --force*)",
            "Bash(git push -f*)",
            "Bash(git reset --hard*)",
            "Bash(rm -rf*)",
            "Bash(*--dangerously-skip-permissions*)",
            "Bash(*--no-verify*)"
        ]
    },
    "hooks": {
        "SessionStart": [{ "hooks": [{ "type": "command", "command": "~/.claude/hooks/session-start-reminder.sh" }] }],
        "PreToolUse": [
            { "matcher": "Bash", "hooks": [{ "type": "command", "command": "rtk hook claude" }] }
        ]
    }
}
